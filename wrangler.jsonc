{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "marmoristapro-vendas",
  // worker.js: bloqueio da lista de bloqueio do app; só roda na página, o resto vem direto dos arquivos
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  }
}
